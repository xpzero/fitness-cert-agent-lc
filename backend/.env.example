# 复制为 .env 并填入真实值
LLM_API_KEY=your-key-here
# 生成侧单独换厂商时才需要（缺省沿用 LLM_API_KEY）
# GEN_API_KEY=
# GEN_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# fast 通道 base_url（新名 FAST_BASE_URL；旧名 ZHIPU_BASE_URL 仍兼容）
# FAST_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 生成模型（教材溯源问答/出题）
GEN_MODEL=glm-4.6
# 轻量模型（路由/自检/评分/判分复核）
FAST_MODEL=glm-4-flash
# LLM provider（langchain init_chat_model 的厂商字符串；OpenAI 兼容协议厂商都用
# openai+上方 BASE_URL。换非兼容厂商时改此项并安装对应 langchain-* 集成包）
LLM_PROVIDER=openai
# 传输层重试次数（langchain 集成处理）
LLM_MAX_RETRIES=3

# 数据库（docker-compose 提供）
DATABASE_URL=postgresql+psycopg://fitness:fitness@localhost:5433/fitness
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx

# ---- Agent 升级（W1–W7，全部有代码内默认值，按需覆盖） ----
# 出题并行 worker 数（W1）
# QUIZGEN_PARALLEL_WORKERS=4
# 对抗评审开关（W2；0 = 回退旧闸门链）
# ADVERSARIAL_GATE_ENABLED=1
# cross-encoder 精排（W6；默认关——CPU 延迟 ~16s/条，开前看 eval/report 对比）
# RERANK_ENABLED=1
# 学情诊断 agent 最大步数（W3）/ 讲题教练最大轮数（W4）
# DIAGNOSIS_MAX_STEPS=8
# COACH_MAX_ROUNDS=5
# 意图路由低置信阈值（W5）：低于此值的开放式消息交给导师 agent
# ROUTE_CONFIDENCE_MIN=0.55
